# Managed by Ansible (k3s-vmware-lab). Mirrors the unit k3s' install.sh generates for {{ k3s_version }}.
[Unit]
Description=Lightweight Kubernetes ({{ k3s_mode }})
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
Type={{ 'notify' if k3s_mode == 'server' else 'exec' }}
KillMode=process
Delegate=yes
User=root
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s {{ k3s_mode }}
