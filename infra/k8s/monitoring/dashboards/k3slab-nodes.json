        "query": {
          "qryType": 1,
          "query": "label_values(node_uname_info, node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(node_uname_info, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
