          },
          "expr": "k3slab_infer_queue_length{release=~\"$release\"}",
          "legendFormat": "큐 길이 · {{pod}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
