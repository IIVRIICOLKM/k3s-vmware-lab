          },
          "expr": "k3slab_infer_queue_capacity{release=~\"$release\"}",
          "legendFormat": "용량 (MAX_QUEUE) · {{pod}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
