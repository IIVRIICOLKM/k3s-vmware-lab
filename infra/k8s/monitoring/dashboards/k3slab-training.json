{
  "uid": "k3slab-training",
  "title": "학습 작업",
  "description": "MySQL jobs·job_events 테이블(작업 상태)과 학습 파드의 쿠버네티스 지표. 작업 상태는 Prometheus가 아니라 MySQL 데이터소스(읽기 전용)에서 읽는다.",
  "tags": [
    "k3slab",
    "train",
    "jobs"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "job_type",
        "label": "작업 종류",
        "type": "custom",
        "query": "train,infer",
        "current": {
          "selected": true,
          "text": "train",
          "value": "train"
        },
        "options": [
          {
            "selected": true,
            "text": "train",
            "value": "train"
          },
          {
            "selected": false,
            "text": "infer",
            "value": "infer"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "작업 상태별 개수",
      "description": "MySQL jobs 테이블의 상태별 작업 수(위의 '작업 종류' 선택). 읽기 전용 계정 k3slab_ro로 직접 읽는다.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-k3slab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-k3slab"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.status AS status, COUNT(j.job_id) AS jobs FROM (SELECT 'PENDING' AS status UNION ALL SELECT 'RUNNING' UNION ALL SELECT 'INTERRUPTED' UNION ALL SELECT 'DONE' UNION ALL SELECT 'FAILED') AS s LEFT JOIN jobs AS j ON j.status = s.status AND j.job_type = '$job_type' GROUP BY s.status ORDER BY FIELD(s.status, 'PENDING', 'RUNNING', 'INTERRUPTED', 'DONE', 'FAILED')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "jobs"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^jobs$/",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "종류 × 상태 (전체)",
      "description": "jobs 테이블 전체(train·infer)를 종류와 상태로 센 값.",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 6,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-k3slab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-k3slab"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT job_type AS type, status, COUNT(*) AS jobs FROM jobs GROUP BY job_type, status ORDER BY job_type, status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "진행 중 학습의 진행률 (%)",
      "description": "PENDING·RUNNING·INTERRUPTED 학습의 현재 에폭 / 전체 에폭. 에폭 숫자는 아래 표 참고.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-k3slab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-k3slab"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT job_id, ROUND(100 * CAST(JSON_UNQUOTE(JSON_EXTRACT(detail, '$.epoch')) AS UNSIGNED) / NULLIF(CAST(JSON_UNQUOTE(JSON_EXTRACT(detail, '$.epochs')) AS UNSIGNED), 0), 0) AS progress FROM jobs WHERE job_type = 'train' AND status IN ('PENDING', 'RUNNING', 'INTERRUPTED') ORDER BY updated_at DESC LIMIT 12"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^progress$/",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "작업 목록 (최근 갱신순)",
      "description": "job_id, 상태, 시도 횟수(attempts), 에폭 / 전체 에폭, loss, 모델 버전, 마지막 갱신. 에폭·loss는 detail(JSON)에서 꺼낸다.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-k3slab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-k3slab"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT job_id, status, attempts, CAST(JSON_UNQUOTE(JSON_EXTRACT(detail, '$.epoch')) AS UNSIGNED) AS epoch, CAST(JSON_UNQUOTE(JSON_EXTRACT(detail, '$.epochs')) AS UNSIGNED) AS epochs, CAST(JSON_UNQUOTE(JSON_EXTRACT(detail, '$.loss')) AS DECIMAL(12,6)) AS loss, model_version AS version, updated_at FROM jobs WHERE job_type = '$job_type' ORDER BY updated_at DESC LIMIT 30"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "PENDING": {
                        "color": "blue",
                        "text": "PENDING"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "RUNNING": {
                        "color": "green",
                        "text": "RUNNING"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "INTERRUPTED": {
                        "color": "orange",
                        "text": "INTERRUPTED"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "DONE": {
                        "color": "dark-green",
                        "text": "DONE"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "FAILED": {
                        "color": "red",
                        "text": "FAILED"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "진행 에폭 (실행·중단 작업)",
      "description": "RUNNING·INTERRUPTED 학습의 에폭 / 전체 에폭.",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-k3slab"
