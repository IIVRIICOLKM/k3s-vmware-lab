      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "상태 변화 이력 (최근)",
      "description": "job_events의 최근 50줄 (선택한 시간 범위).",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "mysql-k3slab"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-k3slab"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT at, job_id, status, CAST(JSON_UNQUOTE(JSON_EXTRACT(detail, '$.epoch')) AS UNSIGNED) AS epoch, JSON_UNQUOTE(JSON_EXTRACT(detail, '$.resumed_from')) AS resumed_from, JSON_UNQUOTE(JSON_EXTRACT(detail, '$.error')) AS error FROM job_events WHERE $__timeFilter(at) ORDER BY id DESC LIMIT 50"
