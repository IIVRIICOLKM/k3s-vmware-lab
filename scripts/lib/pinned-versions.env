# Tool versions this workflow is pinned to. preflight.sh fails on any mismatch.
# Status: VERIFIED by scripts/provider-smoke-test.sh (2 consecutive passes) on this host.
#
# [한국어 설명] 이 프로젝트가 "이 호스트에서 검증된 조합"으로 고정한 도구 버전·해시 목록. common.sh가 불러온다.
#   - preflight.sh가 실제 설치된 버전과 비교해서 다르면 FAIL을 낸다.
#   - 버전을 올리려면: 도구 업데이트 → 이 파일 수정 → scripts/provider-smoke-test.sh 재통과 → PIN_VERIFIED_ON 갱신
# 검증 상태·날짜 (preflight 출력의 "Pinned tool versions" 제목 옆에 표시됨)
PIN_STATUS="verified"
PIN_VERIFIED_ON="2026-09-18"

# 호스트 도구 버전: VMware Workstation(버전 + 빌드 번호), vmrest, Terraform, Packer, ansible-core
PIN_WORKSTATION_VERSION="26.0.0"
PIN_WORKSTATION_BUILD="25388281"
PIN_VMREST_VERSION="1.3.1"
PIN_TERRAFORM_VERSION="1.16.3"
PIN_PACKER_VERSION="1.16.0"
PIN_ANSIBLE_CORE_VERSION="2.21.4"
# Terraform provider(elsudano/vmworkstation) 버전과 배포 zip의 SHA-256
#   → preflight.sh·provider-smoke-test.sh가 infra/terraform/.terraform.lock.hcl의 "zh:" 해시와 비교
PIN_PROVIDER_VMWORKSTATION_VERSION="2.0.1"
PIN_PROVIDER_VMWORKSTATION_ZIP_SHA256_LINUX_AMD64="3df78cd7fdc20408c70afea258b126c1f09fad7a7c4ca83dc7bc43782dab7c7e"

# 게스트 OS: Rocky Linux 9.8 DVD ISO의 파일명·크기(바이트)·SHA-256, Rocky 공식 서명 키 지문
#   → fetch-rocky-iso.sh(다운로드 검증), golden-build.sh(빌드 전 재검증), preflight.sh(점검)에서 사용
PIN_GUEST_OS="Rocky Linux 9.8 Server (no GUI)"
PIN_ROCKY_ISO_FILENAME="Rocky-9.8-x86_64-dvd.iso"
PIN_ROCKY_ISO_SIZE="15194259456"
PIN_ROCKY_ISO_SHA256="d2bcbb64c2d67511adf80d40cd9543391a33aea5860a355b1d26d7f55236d01f"
PIN_ROCKY_GPG_FINGERPRINT="21CB256AE16FC54C6E652949702D426D350D275D"
# K3s SELinux 정책 RPM(k3s-selinux) 버전·SHA-256과 Rancher RPM 서명 키 해시 (기록용)
#   셸 스크립트는 이 값을 읽지 않는다. Ansible이 실제로 쓰는 값은 infra/ansible/inventories/lab/group_vars/all.yml
#   → 버전을 바꿀 때는 두 파일을 같이 고쳐야 한다.
PIN_K3S_SELINUX_RPM_VERSION="1.6-1.el9"
PIN_K3S_SELINUX_RPM_SHA256="1115a1223b0db998c7977c879f2a3a6f07a0c63240f68f6e3b665a7ae27c38f7"
PIN_RANCHER_RPM_KEY_SHA256="7d2415f7fc532c365c8874bfad966566daaa0d04a9a5ba14d1db6080a9c12629"

# GPU 호스트(gpu-host) 구성 버전 (기록용)
#   셸 스크립트는 이 값을 읽지 않는다. 실제로 쓰는 곳:
#     NVIDIA Container Toolkit 버전·저장소 키 해시 → infra/ansible/inventories/lab/group_vars/gpu_nodes.yml
#     NVIDIA device plugin 이미지 태그           → infra/k8s/nvidia-device-plugin.yaml
#   → 버전을 바꿀 때는 이 파일과 위 두 파일을 같이 고쳐야 한다.
PIN_NVIDIA_CTK_VERSION="1.20.1-1"
PIN_NVIDIA_CTK_GPGKEY_SHA256="c880576d6cf75a48e5027a871bac70fd0421ab07d2b55f30877b21f1c87959c9"
PIN_K8S_DEVICE_PLUGIN_VERSION="v0.20.1"

# Helm (호스트 ~/.local/bin/helm, 사용자 권한 설치) — preflight.sh가 버전을 비교한다
#   설치 파일 SHA-256은 https://get.helm.sh/helm-v<버전>-linux-amd64.tar.gz.sha256sum 과 같아야 한다
PIN_HELM_VERSION="4.3.1"
PIN_HELM_TARBALL_SHA256="0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b"

# 이미지·빌드 구성요소 버전 (기록용)
#   셸 스크립트는 이 값을 읽지 않는다. 실제로 쓰는 곳:
#     레지스트리 registry:3.1.2              → infra/k8s/registry.yaml
#     Kaniko martizih/kaniko:v1.28.6         → scripts/image-build.sh (KANIKO_IMAGE)
#     학습 베이스 pytorch 2.14.1 + CUDA 13.0 → apps/train/Dockerfile (호스트 드라이버 580의 최대 CUDA가 13.0)
#   → 버전을 바꿀 때는 이 파일과 위 파일을 같이 고쳐야 한다.
PIN_REGISTRY_IMAGE="docker.io/library/registry:3.1.2"
PIN_KANIKO_IMAGE="docker.io/martizih/kaniko:v1.28.6"
PIN_TRAIN_BASE_IMAGE="docker.io/pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime"

# 추론 워커 빌드 구성요소 (기록용) — 실제로 쓰는 곳: apps/infer/Dockerfile (ARG 기본값)
#   cpp-httplib는 860KB 단일 헤더라 저장소에 넣지 않고, 빌드 때 이 버전·SHA-256으로 받아 검증한다
PIN_CPP_HTTPLIB_VERSION="v0.64.0"
PIN_CPP_HTTPLIB_SHA256="805169049e6a6e9ba7729d7e01d14ced825029c88a277586602a6b38df4d5357"
PIN_INFER_BUILD_IMAGE="docker.io/library/gcc:15.3.0-trixie"
PIN_INFER_RUNTIME_IMAGE="docker.io/library/debian:trixie-20261027-slim"
